# Rename this file to application-local.properties and fill in real values.
# application-local.properties is git-ignored and must never be committed.
# Activate with: --spring.profiles.active=local  or  SPRING_PROFILES_ACTIVE=local

openai.api.key=your_openai_api_key_here
openai.model=gpt-3.5-turbo

spring.datasource.url=jdbc:postgresql://localhost:5432/mealgendb
spring.datasource.username=postgres
spring.datasource.password=your_db_password_here
