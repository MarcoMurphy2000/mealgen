        <mxCell id="17" value="&lt;h1 align=&quot;center&quot; style=&quot;margin-top: 0px;&quot;&gt;API Layer&lt;br&gt;&lt;/h1&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;: Handles HTTP requests.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Input&lt;/b&gt;: Receives a DTO from the client.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Mapping&lt;/b&gt;: Uses the &lt;i&gt;DTO-to-Domain&lt;/i&gt; Mapper to map the DTO to a domain object.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Output&lt;/b&gt;: Sends HTTP requests, usually containing DTO&#39;s&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="180" y="400" width="180" height="360" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;h1 align=&quot;center&quot; style=&quot;margin-top: 0px;&quot;&gt;Business Logic Layer&lt;br&gt;&lt;/h1&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;: Processes domain objects.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Input&lt;/b&gt;: Receives domain objects from the controller (already mapped from DTOs).&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Mapping&lt;/b&gt;: May use a &lt;i&gt;Domain-to-Entity&lt;/i&gt; Mapper to convert domain objects to entities which can be persisted in db by repository layer.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Output&lt;/b&gt;: After processing, it may return domain objects, which are mapped to DTOs by the controller&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="180" height="380" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;h1 align=&quot;center&quot; style=&quot;margin-top: 0px;&quot;&gt;Persistence Layer (DAO)&lt;br&gt;&lt;/h1&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;: Interacts with database.&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Input&lt;/b&gt;: Receives entities from service layer.&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Mapping&lt;/b&gt;: No additional mapping happens here. Repository directly works with entities sent from service layer&lt;b&gt;.&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="180" height="360" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Inside the controller layer we call the Service layer, delegating the business logic to the service layer." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="205" y="40" width="150" height="80" as="geometry" />
